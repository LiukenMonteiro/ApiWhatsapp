# Configurações do servidor
PORT=3000

# Número do WhatsApp Business que vai enviar as mensagens
# Somente dígitos, com DDI (55) + DDD + número
# Exemplo: 5511999990001
WHATSAPP_NUMERO=5511999990001

# Chave de segurança para a API (protege os endpoints)
# Troque por uma string aleatória longa antes de usar em produção
API_KEY=troque_por_uma_chave_secreta_aleatoria
